  <!--
    原 CadPartSplitter 工程的源码直接编译进本程序：一个 MSIFAITOOLS.exe 就能做零件分割，
    不再需要外部 CadPartSplitter.exe 子进程。用「链接」而不是把文件复制过来，
    保证两边只有一份源码，改一处即生效。

    排除项及原因：
      Program.cs                  → 自带 Main，会和本程序 Program.cs 的 Main 冲突（CS0017）
      CommandLineRunner.cs        → 命令行模式（参数解析 + Console 输出），界面里用不到
      MainForm.cs / .Designer.cs  → 分割工程自带的窗口（本程序用 Form1）
      PdfInfoEditorForm.*         → 上面那个窗口的部品表编辑对话框
                                    （GuiSettings.cs 不排除：它只依赖 DetectorOptions，
                                      不含窗口代码，SplitApi 的调用示例也会用到它）
      PdfRenderer.cs              → 用 Docnet.Core 渲染；本工程改用 PdfiumViewer 重写
                                    （见本工程 CadPartSplitter\PdfRenderer.cs），
                                    否则 Docnet.Core 与 PdfiumViewer 的同名原生库
                                    pdfium.dll 会在输出目录里互相覆盖
  -->
  <ItemGroup>
    <!-- 合并后本工程自己的渲染实现（PdfiumViewer），API 与原 Docnet.Core 版一致 -->
    <Compile Include="CadPartSplitter\PdfRenderer.cs" />
    <Compile Include="..\CadPartSplitter\*.cs" Exclude="..\CadPartSplitter\Program.cs;..\CadPartSplitter\CommandLineRunner.cs;..\CadPartSplitter\MainForm.cs;..\CadPartSplitter\MainForm.Designer.cs;..\CadPartSplitter\PdfInfoEditorForm.cs;..\CadPartSplitter\PdfInfoEditorForm.Designer.cs;..\CadPartSplitter\PdfRenderer.cs">
      <Link>CadPartSplitter\%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Excel 部品表 AI 判定的提示语：编译进 exe 作兜底，同时复制到输出目录（可运行时修改、不用重新编译） -->
    <EmbeddedResource Include="..\CadPartSplitter\Prompts\TzJsonAi.Prompt.txt">
      <LogicalName>CadPartSplitter.Prompts.TzJsonAi.Prompt.txt</LogicalName>
    </EmbeddedResource>
    <None Include="..\CadPartSplitter\Prompts\TzJsonAi.Prompt.txt">
      <Link>Prompts\TzJsonAi.Prompt.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <None Include="部品マスタ\Tbl_部品マスタ.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- 部材部品マスタ（【AI 分析】部材名判定用）：AI 运行时读输出目录里的这一份 -->
    <None Include="部材部品\部材部品.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- AI 提示语：同一份文件既编译进 exe（兜底用），又复制到输出目录（可运行时编辑） -->
    <EmbeddedResource Include="Form1.resx">
      <DependentUpon>Form1.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Prompts\AiPartAnalyzer.Prompt.txt">
      <LogicalName>MSIFAITOOLS.Prompts.AiPartAnalyzer.Prompt.txt</LogicalName>
    </EmbeddedResource>
    <!-- 【AI 分析】部材名判定提示语：同样既编译进 exe（兜底），又复制到输出目录（可运行时编辑） -->
    <EmbeddedResource Include="Prompts\MemberNameAdvisor.Prompt.txt">
      <LogicalName>MSIFAITOOLS.Prompts.MemberNameAdvisor.Prompt.txt</LogicalName>
    </EmbeddedResource>
    <!-- 【CMD 分析】特注品 CSV 的 AI 补足提示语：同样既编译进 exe（兜底），又复制到输出目录（可运行时编辑） -->
    <EmbeddedResource Include="Prompts\SpecialProductAdvisor.Prompt.txt">
      <LogicalName>MSIFAITOOLS.Prompts.SpecialProductAdvisor.Prompt.txt</LogicalName>
    </EmbeddedResource>
    <None Include="hiroidashiData\h_H310_三方枠.xlsx">
