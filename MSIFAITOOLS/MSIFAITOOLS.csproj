    <!--
      用 PackageReference 还原带原生库的包时，NuGet 要求项目把会实际用到的 RID 显式写进
      RuntimeIdentifiers，否则会报：
        Your project file doesn't list 'win-x64' as a "RuntimeIdentifier".
        You should add 'win-x64' to the "RuntimeIdentifiers" property in your project file
        and then re-run NuGet restore.
      OpenCvSharp4.runtime.win 只带 runtimes\win-x64、runtimes\win-x86 两套原生库，
      而本程序固定 x64（见下方 PlatformTarget / Prefer32Bit），所以声明 win-x64。
      win-x64 在 RID 图里继承 win，保留 win 仅为兼容以前的还原结果。
    -->
    <RuntimeIdentifiers>win;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <!--
      必须 x64：合并进来的零件分割源码用 OpenCvSharp4，而 OpenCvSharp4.runtime.win
      只带 win-x64 原生库；AnyCPU 下在 32 位进程里会抛 BadImageFormatException。
      Prefer32Bit 也要显式关掉，否则 AnyCPU 的 exe 默认以 32 位启动。
    -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
