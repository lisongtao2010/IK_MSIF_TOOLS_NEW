<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!--
      注意：不要用 configSections 节点声明 System.Windows.Forms.ApplicationConfigurationSection。
      该节在 .NET Framework 4.8 中已由框架内置注册，重复声明会导致配置系统初始化失败
      （構成システムを初期化できませんでした），进而使 ConfigurationManager.AppSettings 全部读不到，
      表现为 AiApiKey 明明已填写却一直提示“未配置密钥”。
    -->
    <System.Windows.Forms.ApplicationConfigurationSection>
        <add key="DpiAwareness" value="PerMonitorV2" />
    </System.Windows.Forms.ApplicationConfigurationSection>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- AI（OpenAI 兼容接口）配置
             优先级：环境变量 MSIF_AI_API_KEY / MSIF_AI_BASE_URL / MSIF_AI_MODEL / MSIF_AI_TIMEOUT_SECONDS
                    → 程序内【AI 设置】画面保存的 %APPDATA%\MSIFAITOOLS\ai-settings.json
                    → 本文件的 appSettings（下面这几项仅为初始默认值） -->
        <add key="AiBaseUrl" value="https://api-ap-southeast-1.modelarts-maas.com/v1" />
        <add key="AiApiKey" value="RG1wlfD1ixUC0DOfX4HJw7KHc_orZYD7_KJw2gxoVjBtAVWCGSKN1JwBcKHYsf-BR2FzDtlMgTiyOVFA4rPCKQ" />
        <add key="AiModel" value="deepseek-v4-flash" />
        <add key="AiTimeoutSeconds" value="180" />
        <!-- AI 调用方式：api = 云端 OpenAI 兼容接口（使用上面的 AiBaseUrl / AiApiKey / AiModel）；
             claude-cli = 本机 Claude Code CLI（claude -p，不需要 API Key）。
             程序内【AI 设置】可随时切换；环境变量 MSIF_AI_PROVIDER 优先级更高。 -->
        <add key="AiProvider" value="api" />
        <!-- 本机 Claude Code CLI（AiProvider = claude-cli 时使用）：
             ClaudeCliPath：一般「留空即可」——自动查找（先 PATH，即"能在 cmd 里直接敲 claude"就一定能找到；
               再查 %USERPROFILE%\.local\bin、%APPDATA%\npm 等常见安装位置）。
               只有装在非常规位置时才需要填 claude.exe / claude.cmd 的完整路径。
             ClaudeModel：模型名；留空 = 本机 Claude Code 的默认模型；
             ClaudeCliEnvironment：追加环境变量，KEY=VALUE 用 ; 分隔
               （例如通过 Google Cloud / Vertex 认证时填 CLAUDE_CODE_USE_VERTEX=1;CLOUD_ML_REGION=asia-northeast1）。
             环境变量 MSIF_CLAUDE_CLI_PATH / MSIF_CLAUDE_MODEL / MSIF_CLAUDE_CLI_ENV 优先级更高。 -->
        <add key="ClaudeCliPath" value="" />
        <add key="ClaudeModel" value="" />
        <add key="ClaudeCliEnvironment" value="" />
        <!-- 部品基本信息数据库（部品基本信息表）。
             默认放在「所选 PDF 文件夹\AiAppData\MSIF_Parts.db」——数据库跟着图纸文件夹走，
             一个项目一份库（把文件夹拷走就带走了部品数据）。
             这里留空 / 不写 = 用默认位置；
             填相对路径 = 相对 AiAppData（例：MSIF_Parts.db、db\MSIF_Parts.db）；
             填绝对路径 = 固定用那个文件（例：D:\MSIFDB\MSIF_Parts.db）。
             旧版本把库放在 程序目录\Data\MSIF_Parts.db：新位置还没有库时会自动复制过去。 -->
        <add key="PartDatabasePath" value="" />
        <!-- 部材部品マスタ（原 部材部品\部材部品.csv）的 SQLite 数据库。
             留空 / 不写时默认 D:\MSIFDB\MSIF_MemberParts.db（D 盘不可用时退回 程序目录\Data\MSIF_MemberParts.db）；
             也可以只写文件夹（自动补 MSIF_MemberParts.db），相对路径按程序目录解析。
             环境变量 MSIF_MEMBER_PARTS_DB 优先级更高。
             第一次运行会把 部材部品\部材部品.csv 导入「部材部品」表，之后只读数据库；
             要重新导入，清空该表或删掉数据库文件即可。
             「部材名置换」表不在这个 SQLite 库里，而在 SQL Server（见下面的 MappingDb*）。 -->
        <add key="MemberPartDatabasePath" value="D:\MSIFDB\MSIF_MemberParts.db" />
        <!-- 部材名面板（部材名置换表）读 SQL Server 的 genpin.dbo.T_M_MergeName：
             MsifDevName（表示部材名 = 图纸 / parts_info.json 上取得的词）→ GenpinName（原部材名 = genpin 主档的叫法），
             本工具的画面（选择部材名窗口）显示 / 保存的是 MsifDevName 一侧的写法；
             只取 DeleteFlg = 0 的行（bit / int / char 都按文字判断）。
             【CMD 分析】第 6 步「使い分け自動設定」也用这一份连接信息，
             读同一个库的 T_M_PartsMaster（[ShapeNumber] = 部品コード → [BranchNumber] = 使い分け），
             连不上时那一小步退回读旧的 hiroidashiData 文件夹里的 xlsx。
             程序启动时整表读进内存（Program.PrepareMemberNameMapping → MemberNameReplacementCatalog.Preload），
             之后分析 / 保存时的部材名置换不再连数据库。
             连接信息在主画面【接続① genpin】或【部材名面板】的【连接设置】里维护（保存到
             %APPDATA%\MSIFAITOOLS\mapping-db-settings.json，密码 DPAPI 加密，connJP1 分节）；
             下面几项只是初始默认值，优先级：环境变量（MSIF_MAPPING_DB_*）
             → 连接设置画面保存的 connJP1 → 本文件的具名连接（connJP1）→ appSettings 的 MappingDb* → 内置默认值。
             表结构：Classification（分類）/ MsifDevName（置换前）/ GenpinName（置换后）/
                     DeleteFlg（削除フラグ）/ CreateBy・CreateTime / UpdateBy・UpdateTime。
             本工具只读这张表（不追加 / 不更新 / 不削除），维护请到 genpin 侧进行。 -->
        <add key="MappingDbServer" value="10.103.126.208" />
        <add key="MappingDbPort" value="1433" />
        <add key="MappingDbDatabase" value="genpin" />
        <add key="MappingDbUser" value="sqluser_dairen" />
        <add key="MappingDbPassword" value="dairen1111##" />
    </appSettings>
    <!-- 具名数据库连接：程序内部按名字取连接信息（MemberMappingDbSettingsStore.ResolveByName）。
         connJP1 = 10.103.126.208 / genpin —— 部材名置换表 [genpin].[dbo].[T_M_MergeName]
                   （MsifDevName → GenpinName）以及【CMD 分析】第 6 步的 [genpin].[dbo].[T_M_PartsMaster]
                   都用这一份；程序里的默认连接名就是它。
         connJP2 = 10.103.126.209 / MSIF —— 部材不材 mapping（[MSIF].[dbo].[DL_BuhinBuzaiMapping]）：
                   部品基本信息画面点【保存】时，把画面上的「部品名（BuhinName）/ 部材名（BuzaiName）/
                   部品コード（BuhinCd）」登录 / 更新进这张表（主键 = BuhinName + BuzaiName，
                   BuhinCd 为空时保留表里原来的值，UpdatedAt 每次刷新）。
                   部品基本信息画面打开时整表读进内存（Services\BuhinBuzaiMappingCatalog.cs），
                   当「选择部材名」窗口的推荐项：部品CD（BuhinCd）一致的 BuzaiName → 部品名（BuhinName）
                   一致的 BuzaiName；保存成功后重新读一次，所以刚登录的组合下一次就能推荐出来。
                   连接信息由 MemberMappingDbSettingsStore.ResolveJp2() 解析
                   （环境变量 MSIF_MAPPING_DB_* → 主画面【接続② MSIF】保存的 connJP2 分节
                   → 本文件的 connJP2 → 内置默认值）。
                   现场没有这台库时可以把下面那一行整行注释掉：保存照样成功，只是画面上会多一句
                   「部材不材 mapping 登录失败 …」。
        取值优先级（ResolveByName）：环境变量 MSIF_MAPPING_DB_* → 连接设置画面保存的该连接
             → 本文件的同名具名连接 → appSettings 的 MappingDb* → 内置默认值。
            两个连接各存一份：connJP1（主画面【接続① genpin】）和 connJP2（主画面【接続② MSIF】）
            分别写进 mapping-db-settings.json 的同名分节，改一个不影响另一个；
            现场换服务器 / 改密码用环境变量或连接设置画面即可，不用改本文件。
         这里的密码是明文；连接设置画面保存的密码用 DPAPI（当前用户）加密。 -->
    <connectionStrings>
        <add name="connJP1" connectionString="Data Source=10.103.126.208,1433;Initial Catalog=genpin;User ID=sqluser_dairen;Password=dairen1111##;" providerName="System.Data.SqlClient" />
        <add name="connJP2" connectionString="Data Source=10.103.126.209,1433;Initial Catalog=MSIF;User ID=sqluser_dairen;Password=dairen1112##;" providerName="System.Data.SqlClient" />
    </connectionStrings>

</configuration>
