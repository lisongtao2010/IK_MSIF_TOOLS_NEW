  "other_words": [
    { "text": "１．フラットレールの上に保護ダンボール（5x50x90",
      "pixel": { "x": 391, "y": 249, "w": 1771, "h": 72 },
      "pdf_mm": { "x": 33.10, "y": 21.08, "w": 149.94, "h": 6.10 } },
    { "text": "4枚）をセットし、",
      "pixel": { "x": 2188, "y": 252, "w": 563, "h": 69 },
      "pdf_mm": { "x": 185.25, "y": 21.34, "w": 47.67, "h": 5.84 } },
    { "text": "縦枠１・ポリシートを重ねる。",
